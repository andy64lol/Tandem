struct Player {
    str name;
    int age;
    int score;
}

fn addScore(int current, int points) -> int {
    return current + points;
}

Player player = { name = "Andy", age = 15, score = 500 };
player.score = addScore(player.score, 25);

int mode = 0;
mode = "training" as str;

if (player.score > 500) {
    print(player.name, "is ready to play");
} else {
    print(player.name, "needs more practice");
}

for (round, 1, 3) {
    printf("Round {round}");
}

print("Mode:", mode, "Score:", player.score);
